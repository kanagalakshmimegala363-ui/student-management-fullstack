# Copy this file to backend/.env for local development. NEVER commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app

# Option A (recommended, required on Vercel): one connection string (Neon / Supabase / Vercel Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option B (local only): local MySQL. Needs: pip install -r requirements-local-mysql.txt
# DB_NAME=student_db
# DB_USER=root
# DB_PASSWORD=your-password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# If you leave both options empty, a local SQLite file (backend/db.sqlite3) is used.

# Extra origins allowed to call the API from another domain (comma separated). Not needed
# when frontend and API are deployed together on Vercel.
# CORS_ALLOWED_ORIGINS=https://my-frontend.example.com
# CSRF_TRUSTED_ORIGINS=https://my-project.vercel.app
